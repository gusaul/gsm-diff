{
  "manifest_version": 3,
  "name": "GCP Secret Manager & Log Diff (GSM Diff)",
  "version": "1.0.1",
  "description": "Compare historical changes and secret values between Google Secret Manager versions and log records in Google Cloud Console.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.clients6.google.com/*",
    "https://clients6.google.com/*",
    "https://console.cloud.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.cloud.google.com/*"
      ],
      "js": [
        "diff-engine.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GSM Diff",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
